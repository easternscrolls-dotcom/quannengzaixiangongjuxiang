# ============================================================
#  72Tool · Apache 配置（Nginx / Cloudflare Pages 请改用 _headers）
#  Gzip/Brotli 压缩 + 浏览器缓存 + Content-Language + 安全头
# ============================================================

# ---------- 1. 压缩（Brotli 优先，回退 Gzip）----------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- 2. 浏览器缓存（速度 = 谷歌核心排名因子）----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                 "access plus 30 minutes"
    ExpiresByType text/css                  "access plus 7 days"
    ExpiresByType application/javascript    "access plus 7 days"
    ExpiresByType image/png                 "access plus 30 days"
    ExpiresByType image/jpeg                "access plus 30 days"
    ExpiresByType image/webp                "access plus 30 days"
    ExpiresByType image/svg+xml             "access plus 30 days"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

# ---------- 3. Content-Language（爬虫快速识别语种）----------
<IfModule mod_headers.c>
    Header set Content-Language "zh-CN"
    <FilesMatch "^index\.html$">
        Header set Content-Language "zh-CN"
    </FilesMatch>
</IfModule>
<Directory "en">
    <IfModule mod_headers.c>
        Header set Content-Language "en"
    </IfModule>
</Directory>
<Directory "jp">
    <IfModule mod_headers.c>
        Header set Content-Language "ja"
    </IfModule>
</Directory>
<Directory "es">
    <IfModule mod_headers.c>
        Header set Content-Language "es"
    </IfModule>
</Directory>
<Directory "de">
    <IfModule mod_headers.c>
        Header set Content-Language "de"
    </IfModule>
</Directory>
<Directory "ar">
    <IfModule mod_headers.c>
        Header set Content-Language "ar"
    </IfModule>
</Directory>

# ---------- 4. 安全 & SEO 头 ----------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header append Vary "Accept-Encoding, Accept-Language"
</IfModule>

# ---------- 5. XML 正确 MIME ----------
AddType application/xml .xml
AddType application/rss+xml .rss

# ---------- 6. 强制 HTTPS + 去 www（避免重复内容判定）----------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---------- 7. 隐藏构建脚本 ----------
<FilesMatch "\.(cjs|md)$">
    Require all denied
</FilesMatch>
